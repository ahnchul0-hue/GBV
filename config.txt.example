# ═══════════════════════════════════════════════
# GBV 설정 파일
# ═══════════════════════════════════════════════

# ───────────────────────────────────────
# 키움 실전/모의투자 선택
# kiwoom_mode : real (실전) 또는 demo (모의투자)
#               ※ 실전/모의투자 앱키가 서로 다름
# ───────────────────────────────────────
kiwoom_mode = demo
telegram_bot_token = 123456789:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
telegram_chat_id = 123456789
# ───────────────────────────────────────
# API 정보 (필수)
# openapi.kiwoom.com 에서 발급한 App Key / Secret Key
# 계좌는 앱키에 연결되어 있어 account_no는 표시용(선택)
# ───────────────────────────────────────
app_key    = XXXXXXXXXXXXXXXXXXXXXXX
app_secret = XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
account_no = 12345678
# ───────────────────────────────────────
# 매매 시간
# ───────────────────────────────────────
us_market_time = 22:30
# kr_market_time = 09:00
# ───────────────────────────────────────
# 미국: 알파벳 티커 (tqqq, ugl, soxl 등)
# 국내: 숫자 또는 영문+숫자 (252670, A252670 등)
# ───────────────────────────────────────
# 미국 종목 기준금 및 월 증액률 (달러)
# ───────────────────────────────────────
TQQQ = 10000
TQQQ_monthly_rate = 0.02
# ───────────────────────────────────────
# 국내 종목 기준금 및 월 증액률 (원화)
# 종목코드: 숫자만 (005930) 또는 영문+숫자 (A252670)
# ───────────────────────────────────────
# TIGER 미국나스닥100레버리지(합성) - 나스닥100 2배, 환노출
# 418660 = 10000000
# 418660_monthly_rate = 0.02

# (대안) KODEX 미국나스닥100레버리지(합성 H) - 나스닥100 2배, 환헤지
# 쓰려면 위 418660 두 줄 앞에 #을 붙이고, 아래 두 줄의 #을 지우세요
# 409820 = 10000000
# 409820_monthly_rate = 0.02
# ───────────────────────────────────────
# 기타 설정
# ───────────────────────────────────────
outside_tqqq = 0
trading_enabled = true        # 매매 활성화 (true/false)

# ───────────────────────────────────────
# 자동 업데이트 변수 (봇이 실행 중 아래에 기록합니다)
# 직접 수정하지 마세요
# ───────────────────────────────────────
